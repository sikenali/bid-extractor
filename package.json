{
  "name": "bid-extractor",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "build:desktop": "npm run build && electron-builder",
    "build:desktop:win": "npm run build && electron-builder --win --x64",
    "build:desktop:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "build:desktop:linux": "npm run build && electron-builder --linux --x64",
    "electron:dev": "concurrently \"npm run dev:backend\" \"wait-on http://localhost:3000/health && cross-env NODE_ENV=development electron .\"",
    "postinstall": "electron-builder install-app-deps || echo 'skip native rebuild'"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@open-file-viewer/core": "^0.1.49",
    "@open-file-viewer/vue": "^0.1.49",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "docxtemplater": "^3.71.0",
    "express": "^4.21.0",
    "file-saver": "^2.0.5",
    "js-yaml": "^5.2.1",
    "jszip-utils": "^0.1.0",
    "multer": "^1.4.5-lts.1",
    "officeparser": "^8.1.1",
    "pizzip": "^3.3.0"
  },
  "build": {
    "appId": "com.wenquxing.app",
    "productName": "文取星",
    "directories": {
      "output": "release"
    },
    "files": [
      "frontend/dist/**/*",
      "backend/dist/**/*",
      "backend/package.json",
      "backend/seed-skills/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "backend/node_modules/**/*"
    ],
    "npmRebuild": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "signingHashAlgorithms": [],
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "文取星"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "_excavator": true
  }
}